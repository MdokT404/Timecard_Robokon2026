<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 1. デジタル時計（常時秒まで表示） -->
        <TextView
            android:id="@+id/tv_digital_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="00:00:00"
            android:textColor="#333333"
            android:textSize="64sp"
            android:textStyle="bold" />

        <!-- 2. 5桁ID入力欄 -->
        <EditText
            android:id="@+id/et_user_id"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"
            android:background="@android:drawable/editbox_background_normal"
            android:gravity="center"
            android:hint="ID(学籍番号)を入力"
            android:inputType="number"
            android:maxLength="5"
            android:textSize="24sp" />

        <!-- 3. 打刻ボタンエリア（格子状に配置） -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alignmentMode="alignBounds"
            android:columnCount="2"
            android:columnOrderPreserved="false"
            android:rowCount="3">

            <Button
                android:id="@+id/btn_in_1"
                android:layout_width="0dp"
                android:layout_height="521dp"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#4CAF50"
                android:text="出勤1"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_in_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#2E7D32"
                android:text="出勤2"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_in_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#1B5E20"
                android:text="出勤3"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_out"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#F44336"
                android:text="退勤"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_rest_in"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#FF9800"
                android:text="休憩IN"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_rest_out"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:backgroundTint="#03A9F4"
                android:text="休憩OUT"
                android:textSize="24sp"
                android:textStyle="bold" />
        </GridLayout>

        <!-- 4. 管理用ボタンエリア（最下部） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reload_master"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#795548"
                android:text="名簿マスタ更新"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_export"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#607D8B"
                android:text="ログを出力"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>