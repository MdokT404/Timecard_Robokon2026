<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- 上部と中央の間の絶妙な位置に配置するスペーサー -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6" />

    <!-- 1. デジタル時計 -->

    <!-- 2. 5桁ID入力欄 -->
    <TextView
        android:id="@+id/tv_digital_clock"
        android:layout_width="496dp"
        android:layout_height="110dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif-monospace"
        android:maxLines="1"
        android:singleLine="true"
        android:text="00:00:00"
        android:textAlignment="center"
        android:textColor="#1A1A1A"
        android:textSize="70sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_user_id"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@android:drawable/editbox_background_normal"
        android:gravity="center"
        android:hint="5桁のIDを入力"
        android:inputType="number"
        android:maxLength="5"
        android:textSize="20sp" />

    <!-- 3. 打刻ボタンエリア（スマートフォン最適化: 2列グリッド） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_in_1"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#41FF3A"
                android:text="出勤1(制作員)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_in_2"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#C2B2EF"
                android:text="出勤2(会計員)"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_in_3"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#4AADFF"
                android:text="出勤3(宣伝員)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_out"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FD5B5B"
                android:text="退勤"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_rest_in"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#F57C00"
                android:text="休憩IN"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_rest_out"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#1976D2"
                android:text="休憩OUT"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 下部とのバランス調整用スペーサー -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 4. 管理用ボタンエリア -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_reload_master"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:backgroundTint="#D5E006"
            android:text="名簿更新"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_export"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:backgroundTint="#4293C1"
            android:text="ログ出力"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_open_drive"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:backgroundTint="#0F9D58"
            android:text="Drive設定"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
